{
    "name": "@yakad/ui",
    "version": "2.0.5",
    "private": false,
    "author": "Natiq",
    "description": "UI components for NextJS/React",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "keywords": [
        "yakad",
        "react",
        "react-component"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/natiq-foundation/yakad.git",
        "directory": "packages/ui"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/natiq-foundation/yakad/issues"
    },
    "homepage": "https://yakad.natiq.net",
    "scripts": {
        "clean": "rimraf dist/",
        "generate:color": "tsx src/Theme/color/generator.ts",
        "copy-files:css": "copyfiles -u 1 src/*.css src/**/*.css dist/",
        "copy-files:svg": "copyfiles -u 1 src/*.svg src/**/*.svg dist/",
        "build": "npm run clean && tsc && npm run generate:color && npm run copy-files:css && npm run copy-files:svg",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/**/*.{ts,tsx}",
        "test": "echo \"No tests specified\" && exit 0",
        "prepublishOnly": "npm run lint && npm run test && npm run build && npm run typecheck"
    },
    "dependencies": {
        "@material/material-color-utilities": "^0.4.0",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.12",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.3.0",
        "@radix-ui/react-radio-group": "^1.4.8",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@yakad/lib": "1.0.32",
        "@yakad/symbols": "1.0.43",
        "@yakad/use-interactions": "1.0.0",
        "class-variance-authority": "^0.7.1",
        "classnames": "2.5.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/css-modules": "1.0.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tsx": "^4.23.13"
    }
}