{
    "name": "yakad",
    "version": "1.0.0",
    "private": true,
    "description": "Yakad - A comprehensive React component library and utilities",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace @yakad/use-interactions && npm run build --workspaces",
        "lint": "npm run lint --workspaces",
        "typecheck": "npm run typecheck --workspaces",
        "test": "npm run test --workspaces",
        "prepublish:check": "npm run lint && npm run build && npm run typecheck && npm run test",
        "publish:eslint-plugin-guard": "cd packages/eslint-plugin-guard && npm publish",
        "publish:lib": "cd packages/lib && npm publish",
        "publish:sync": "cd packages/sync && npm publish",
        "publish:symbols": "cd packages/symbols && npm publish",
        "publish:ui": "cd packages/ui && npm publish",
        "publish:x": "cd packages/x && npm publish",
        "publish:use-interactions": "cd packages/use-interactions && npm publish",
        "publish:fonts": "cd packages/fonts && npm publish",
        "idev:docs": "cd docs && npm run idev"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@typescript-eslint/eslint-plugin": "^6",
        "@typescript-eslint/parser": "^6",
        "copyfiles": "^2.4.1",
        "eslint": "^8.0.0 <9.0.0",
        "eslint-plugin-react": "^7",
        "eslint-plugin-react-hooks": "^4",
        "jest": "^30.1.2",
        "rimraf": "^6",
        "ts-jest": "^29.4.1",
        "typescript": "<5.4.0"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/natiq-foundation/yakad.git"
    },
    "keywords": [
        "yakad",
        "react",
        "components",
        "ui",
        "typescript",
        "monorepo"
    ],
    "author": "Natiq",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/natiq-foundation/yakad/issues"
    },
    "homepage": "https://yakad.natiq.net",
    "dependencies": {
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.12",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.3.0",
        "@radix-ui/react-radio-group": "^1.4.8",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0"
    }
}
